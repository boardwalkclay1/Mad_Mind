<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Mad Mind – Map</title>
  <link rel="stylesheet" href="madmind.css" />
</head>
<body>
  <div class="page-shell">
    <header class="mad-topbar">
      <div class="mad-topbar-left">
        <div class="mad-avatar">🗺️</div>
        <div>
          <div class="mad-topbar-title">Survival map</div>
          <div style="font-size:0.7rem;color:rgba(249,243,229,.8);">
            Water • Ice • Parks • Walmarts • Krogers • Home Depots • Lowes
          </div>
        </div>
      </div>
      <div class="mad-topbar-right">
        <button class="mad-icon-btn" onclick="window.location.href='dashboard.html'">⌂</button>
      </div>
    </header>

    <section>
      <div style="margin-bottom:8px;">
        <input id="map-search" class="mad-input" type="text" placeholder="Search places..." />
      </div>
      <div style="margin-bottom:8px;">
        <span class="mad-chip">Water</span>
        <span class="mad-chip">Ice</span>
        <span class="mad-chip">Parks</span>
        <span class="mad-chip">Walmart</span>
        <span class="mad-chip">Kroger</span>
        <span class="mad-chip">Home Depot</span>
        <span class="mad-chip">Lowes</span>
        <span class="mad-chip">Camping</span>
      </div>

      <div class="map-placeholder" id="map-placeholder">
        <!-- Placeholder for now; later drop real map here -->
        <div style="position:absolute;inset:12px;color:rgba(249,243,229,.75);font-size:0.85rem;">
          <p>Prototype map — pins are mocked locally.</p>
          <ul style="margin-top:6px;font-size:0.8rem;list-style:disc;padding-left:18px;">
            <li>Later: Cloudflare Worker /api/places for real data.</li>
            <li>Show water, ice, parks, big-box stores, camping, parking garages.</li>
          </ul>
        </div>
      </div>

      <div class="scroll-panel" style="margin-top:10px;max-height:32vh;">
        <div id="map-places-list"></div>
      </div>
    </section>
  </div>

  <nav class="mad-bottom-nav">
    <button onclick="window.location.href='dashboard.html'">Home</button>
    <button onclick="window.location.href='profile.html'">Profile</button>
    <button onclick="window.location.href='messages.html'">Messages</button>
  </nav>

  <script type="module">
    import { initBubbles } from './bubbles.js';
    initBubbles({ count: 12, clickable: true });

    const places = [
      { id: "p1", name: "City Park Water Spigot", type: "water", desc: "Free spigot behind restroom.", rating: 4.7 },
      { id: "p2", name: "Walmart Supercenter", type: "walmart", desc: "Overnight sometimes allowed; check signs.", rating: 4.1 },
      { id: "p3", name: "Kroger", type: "kroger", desc: "Groceries, ice, public restroom.", rating: 4.0 },
      { id: "p4", name: "State Park Campground", type: "camping", desc: "Showers, water, paid sites.", rating: 4.8 },
      { id: "p5", name: "Downtown Parking Garage", type: "parking", desc: "Shelter during rain, no overnight.", rating: 3.5 }
    ];

    const listEl = document.getElementById("map-places-list");

    function renderPlaces(filter = "") {
      listEl.innerHTML = "";
      const f = filter.toLowerCase();
      const filtered = places.filter(p =>
        p.name.toLowerCase().includes(f) ||
        p.type.toLowerCase().includes(f)
      );
      filtered.forEach(p => {
        const div = document.createElement("div");
        div.style.border = "1px solid rgba(245,197,66,.6)";
        div.style.borderRadius = "10px";
        div.style.padding = "7px 9px";
        div.style.marginBottom = "6px";
        div.innerHTML = `
          <div style="font-size:0.9rem;font-weight:600;color:var(--gold-soft);">${p.name}</div>
          <div style="font-size:0.75rem;color:rgba(249,243,229,.8);margin-top:2px;">${p.desc}</div>
          <div style="font-size:0.75rem;margin-top:3px;">
            <span class="mad-chip">${p.type}</span>
            <span style="margin-left:8px;">⭐ ${p.rating.toFixed(1)}</span>
          </div>
          <button data-id="${p.id}" class="mad-btn mad-btn-secondary" style="margin-top:6px;padding:4px 8px;font-size:0.7rem;width:auto;">
            See reviews
          </button>
        `;
        listEl.appendChild(div);
      });

      listEl.querySelectorAll("button[data-id]").forEach(btn => {
        btn.addEventListener("click", (e) => {
          const id = e.target.getAttribute("data-id");
          // TODO: open dedicated place page; later backed by /api/places/:id
          alert("In full version: open place detail with visible + hidden reviews for " + id);
        });
      });
    }

    renderPlaces();

    document.getElementById("map-search").addEventListener("input", (e) => {
      renderPlaces(e.target.value);
    });

    // TODO (Worker-ready prompt):
    // Replace local 'places' with fetch('/api/places?lat=..&lng=..&types=water,parking,...')
  </script>
</body>
</html>
